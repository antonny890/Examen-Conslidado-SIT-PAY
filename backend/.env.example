# Puerto del Servidor Backend
PORT=5000
NODE_ENV=development

# Web OAuth client ID used to verify Google ID tokens from the mobile app.
GOOGLE_CLIENT_ID=

# Supabase project (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
# Supabase PostgreSQL connection string. Use the pooler URL for deployed backends.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Public Supabase Storage bucket used for profile images.
SUPABASE_STORAGE_BUCKET=profile-photos

# CORS (Frontend Web y Móvil)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Dominios de correo institucional autorizados (Ley 26271)
ALLOWED_EDU_DOMAINS=continental.edu.pe,unsa.edu.pe,ucsm.edu.pe,utp.edu.pe,sanpablo.edu.pe

# Supabase Auth SMTP settings, configured identically in Supabase Dashboard.
# The backend uses the same SMTP account only for institutional verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Consulta DNI Migo (configurar solo en el .env local/servidor; nunca en Flutter)
MIGO_API_TOKEN=replace-with-your-server-token

# Solo en NODE_ENV=development: simula el correo de registro y devuelve el
# código a la app para completarlo automáticamente. No activar en producción.
REGISTRATION_EMAIL_DEV_AUTOFILL=false

# Cuenta de primer acceso para npm run seed:supabase
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAMES=
INITIAL_SUPER_ADMIN_SURNAMES=
