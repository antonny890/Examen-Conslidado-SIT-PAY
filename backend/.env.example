# Puerto del Servidor Backend
PORT=5000
NODE_ENV=development

# Web OAuth client ID used to verify Google ID tokens from the mobile app.
GOOGLE_CLIENT_ID=

# Firebase Authentication REST API key (Firebase Console > Project settings > General)
FIREBASE_WEB_API_KEY=replace-with-your-firebase-web-api-key
# Firebase Storage bucket name, for example project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=sit-pay.firebasestorage.app
# Optional path; defaults to credentials/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# CORS (Frontend Web y Móvil)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Dominios de correo institucional autorizados (Ley 26271)
ALLOWED_EDU_DOMAINS=continental.edu.pe,unsa.edu.pe,ucsm.edu.pe,utp.edu.pe,sanpablo.edu.pe

# SMTP para enviar códigos OTP en acreditaciones universitarias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Consulta DNI Migo (configurar solo en el .env local/servidor; nunca en Flutter)
MIGO_API_TOKEN=b22b5fa2-1e83-49ee-ae39-aae5040a37d7

# Cuenta de primer acceso para npm run seed:firebase
INITIAL_SUPER_ADMIN_EMAIL=+
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAMES=
INITIAL_SUPER_ADMIN_SURNAMES=


RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM=SIT-Pay <onboarding@resend.dev>
# Optional recipient for npm run test:resend (must be allowed by Resend)
RESEND_TEST_TO=