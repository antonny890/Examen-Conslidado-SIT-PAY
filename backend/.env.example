# Puerto del Servidor Backend
PORT=5000
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sit_pay_arequipa
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Seguridad JWT
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=replace-with-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# CORS (Frontend Web y Móvil)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Dominios de correo institucional autorizados (Ley 26271)
ALLOWED_EDU_DOMAINS=continental.edu.pe,unsa.edu.pe,ucsm.edu.pe,utp.edu.pe,sanpablo.edu.pe

# SMTP para enviar códigos OTP en acreditaciones universitarias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Consulta DNI Migo (configurar solo en el .env local/servidor; nunca en Flutter)
MIGO_API_TOKEN=replace-with-your-server-token
