# Puerto del Servidor Backend
PORT=5000
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sit_pay_arequipa
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Seguridad JWT
JWT_SECRET=super_secret_sit_pay_jwt_key_arequipa_2026
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=refresh_super_secret_sit_pay_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS (Frontend Web y Móvil)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Simulación de Correos Institucionales (Ley 26271)
ALLOWED_EDU_DOMAINS=continental.edu.pe,unsa.edu.pe,ucsm.edu.pe,utp.edu.pe,sanpablo.edu.pe

